{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malika",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "public", "index.html", "vite.config.ts"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malika-db",
      "database_id": "70ccddac-4fc9-4d4e-b55a-a2918e2c31a3",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "malika-db",
        "database_id": "70ccddac-4fc9-4d4e-b55a-a2918e2c31a3",
        "migrations_dir": "migrations"
      }
    ]
  }
}
